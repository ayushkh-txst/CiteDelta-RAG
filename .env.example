DATABASE_URL=postgresql://citedelta:citedelta@localhost:5434/citedelta
DATA_DIR=./data
LOG_LEVEL=info

# 'openrouter' (default) or 'anthropic' — see docs/design/06-decisions/ADR-0023.md
LLM_PROVIDER=openrouter

# Required when LLM_PROVIDER=openrouter. One key for both the answer/resolver
# models and embeddings. Get one at https://openrouter.ai/keys — no card needed
# to use the free chat model; embeddings are a paid model (~$0.02/M tokens).
OPENROUTER_API_KEY=

# Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

LLM_MODEL=google/gemma-4-26b-a4b-it:free
RESOLVER_MODEL=google/gemma-4-26b-a4b-it:free
LLM_MAX_TOKENS=4096

EMBEDDING_MODEL=openai/text-embedding-3-small
# Truncated (Matryoshka) from the model's native 1536 dims — keeps the corpus's
# vectors small enough for a free-tier Postgres. See embed/openrouter.py.
EMBEDDING_DIMENSIONS=512
