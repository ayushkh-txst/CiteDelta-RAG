DATABASE_URL=postgresql://citedelta:citedelta@localhost:5434/citedelta
DATA_DIR=./data
LOG_LEVEL=info

# 'openrouter' (default) or 'anthropic' — see docs/design/06-decisions/ADR-0023.md
LLM_PROVIDER=openrouter

# Required when LLM_PROVIDER=openrouter. One key for both the answer/resolver
# models and embeddings. Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# openai/gpt-5.6-luna: paid but cheap (~$0.001/turn). The free
# google/gemma-4-26b-a4b-it:free hit sustained 429s from its shared upstream
# pool (Google AI Studio) in production — confirmed via OpenRouter's API,
# see ADR-0023's update. Swap back to a :free model to keep the $0 baseline,
# at the cost of that congestion risk.
LLM_MODEL=openai/gpt-5.6-luna
RESOLVER_MODEL=openai/gpt-5.6-luna
LLM_MAX_TOKENS=4096

EMBEDDING_MODEL=openai/text-embedding-3-small
# Truncated (Matryoshka) from the model's native 1536 dims — keeps the corpus's
# vectors small enough for a free-tier Postgres. See embed/openrouter.py.
EMBEDDING_DIMENSIONS=512
